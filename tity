<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll('.sqs-entity-wrapper li.tree-node').forEach(node => {
            const childBranch = Array.from(node.children).find(c => c.classList.contains('tree-branch'));
            
            if (childBranch && !node.querySelector(':scope > .toggle-btn')) {
                const btn = document.createElement('button');
                btn.className = 'toggle-btn';
                btn.innerHTML = '−'; 
                btn.title = "Toggle branch visibility";
                
                const card = Array.from(node.children).find(c => c.classList.contains('entity-card'));
                if(card) { node.insertBefore(btn, card); }

                btn.addEventListener('click', () => {
                    childBranch.classList.toggle('collapsed');
                    btn.innerHTML = childBranch.classList.contains('collapsed') ? '+' : '−';
                });
            }
        });
    });
</script>
