<style>
    /* Scoped CSS for Squarespace - 1940s Archival Dossier Aesthetic */
    .sqs-entity-wrapper {
        --board-bg: #e2d3b3; /* Manila folder / aged parchment */
        --card-bg: #f5eedc; /* Aged off-white paper */
        --ink-dark: #2a2520; /* Faded charcoal/brown ink */
        --ink-light: #5e5445; /* Lighter ledger ink */
        --line-color: #96866b; /* Warm brown connector lines */
        --stamp-red: #8f2a23; /* Vintage rubber stamp red */
        
        /* Vintage Color-Coded Headers */
        --hdr-individual: #364149; /* Faded Navy */
        --hdr-toplevel: #4a5141; /* Olive Drab */
        --hdr-subsidiary: #5c564b; /* Warm Slate */
        --hdr-political: #7a3830; /* Rust Red */
        --hdr-foundation: #8c704b; /* Dark Gold/Brass */
        
        font-family: Georgia, "Times New Roman", Times, serif;
        color: var(--ink-dark);
        line-height: 1.5;
        width: 100%;
        overflow-x: auto;
        padding-bottom: 30px;
        box-sizing: border-box;
    }

    .sqs-entity-wrapper * { box-sizing: border-box; }

    /* The Main Board */
    .sqs-master-registry {
        min-width: 860px;
        max-width: 1140px;
        margin: 0 auto;
        background-color: var(--board-bg);
        border: 1px solid #c2b18f;
        box-shadow: inset 0 0 40px rgba(120, 100, 70, 0.1), 0 10px 20px rgba(0,0,0,0.1);
        padding: 40px 50px;
        border-radius: 4px;
    }

    .sqs-entity-wrapper .registry-main-title {
        text-align: center;
        font-size: 26px;
        font-weight: normal;
        text-transform: uppercase;
        letter-spacing: 4px;
        border-bottom: 2px solid var(--ink-dark);
        padding-bottom: 12px;
        margin-bottom: 8px;
    }

    .sqs-entity-wrapper .subtitle {
        text-align: center;
        font-family: "Courier New", Courier, monospace;
        color: var(--ink-light);
        margin-bottom: 45px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .sqs-entity-wrapper .section-title {
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 3px;
        font-weight: bold;
        border-bottom: 1px solid var(--line-color);
        color: var(--ink-dark);
        padding-bottom: 8px;
        margin-bottom: 30px;
        margin-top: 50px;
    }
    
    /* Clean, Organized Tree Layout */
    .sqs-entity-wrapper ul.tree-branch {
        list-style-type: none !important;
        position: relative;
        padding-left: 45px !important; 
        margin: 0 !important;
    }
    
    .sqs-entity-wrapper ul.tree-branch.collapsed { display: none; }
    
    /* Vertical Connector Line */
    .sqs-entity-wrapper ul.tree-branch::before {
        content: "";
        position: absolute;
        left: 18px;
        top: -10px;
        bottom: 0;
        width: 2px;
        background-color: var(--line-color);
    }
    
    /* Hides the tail of the vertical line after the last item */
    .sqs-entity-wrapper ul.tree-branch > li:last-child::after {
        content: "";
        position: absolute;
        left: -22px;
        top: 36px;
        bottom: 0;
        width: 6px;
        background: var(--board-bg);
    }

    .sqs-entity-wrapper li.tree-node {
        position: relative;
        margin: 25px 0 !important;
        padding: 0 !important;
    }
    
    /* Horizontal Connector Line */
    .sqs-entity-wrapper li.tree-node::before {
        content: "";
        position: absolute;
        left: -27px;
        top: 32px;
        width: 27px;
        height: 2px;
        background-color: var(--line-color);
    }
    
    /* Brass Rivet Toggle Button */
    .sqs-entity-wrapper .toggle-btn {
        position: absolute;
        left: -33px;
        top: 25px;
        width: 16px;
        height: 16px;
        background: #d4c29d;
        border: 1px solid var(--ink-dark);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: monospace;
        font-size: 12px;
        font-weight: bold;
        color: var(--ink-dark);
        cursor: pointer;
        z-index: 10;
        padding: 0;
        line-height: 1;
        box-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    }

    .sqs-entity-wrapper .toggle-btn:hover { background: var(--ink-dark); color: #fff; }
    
    /* Dossier Card Design */
    .sqs-entity-wrapper .entity-card {
        background: var(--card-bg);
        border: 1px solid #c2b18f;
        display: inline-block;
        width: 440px;
        vertical-align: middle;
        box-shadow: 2px 3px 5px rgba(0,0,0,0.1), 1px 1px 1px rgba(0,0,0,0.15);
        position: relative;
        z-index: 2;
        border-radius: 2px;
        overflow: hidden;
    }
    
    /* Card Header - Creates instant visual understanding */
    .sqs-entity-wrapper .entity-header {
        padding: 10px 14px;
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid var(--ink-dark);
    }

    .sqs-entity-wrapper .individual .entity-header { background: var(--hdr-individual); }
    .sqs-entity-wrapper .top-level .entity-header { background: var(--hdr-toplevel); }
    .sqs-entity-wrapper .subsidiary .entity-header { background: var(--hdr-subsidiary); }
    .sqs-entity-wrapper .commercial .entity-header { background: var(--hdr-subsidiary); }
    .sqs-entity-wrapper .health-beauty .entity-header { background: var(--hdr-subsidiary); }
    .sqs-entity-wrapper .political .entity-header { background: var(--hdr-political); }
    .sqs-entity-wrapper .foundation .entity-header { background: var(--hdr-foundation); }

    .sqs-entity-wrapper .entity-name {
        font-weight: bold;
        font-size: 15px;
        letter-spacing: 0.5px;
        margin: 0;
    }

    /* Typewriter Label in Header */
    .sqs-entity-wrapper .entity-type {
        font-family: "Courier New", Courier, monospace;
        font-size: 10px;
        text-transform: uppercase;
        opacity: 0.8;
    }

    /* Red Rubber Stamp for Ownership */
    .sqs-entity-wrapper .ownership-badge {
        font-family: "Courier New", Courier, monospace;
        font-size: 10px;
        font-weight: bold;
        color: var(--stamp-red);
        background: transparent;
        border: 2px solid var(--stamp-red);
        padding: 2px 6px;
        transform: rotate(-3deg);
        display: inline-block;
        margin: 12px 14px 4px 14px;
    }

    /* Card Body Form */
    .sqs-entity-wrapper .card-body { padding: 4px 14px 14px 14px; }

    .sqs-entity-wrapper .tax-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px 12px;
        margin-top: 8px;
    }

    .sqs-entity-wrapper .meta-item {
        display: flex;
        flex-direction: column;
        border-bottom: 1px solid #dcd1ba;
        padding-bottom: 4px;
    }

    /* Classic Serif Form Labels */
    .sqs-entity-wrapper .meta-label {
        font-size: 10px;
        text-transform: uppercase;
        color: var(--ink-light);
        margin-bottom: 2px;
        letter-spacing: 0.5px;
    }

    /* Typewriter Input Values */
    .sqs-entity-wrapper .meta-value {
        font-family: "Courier New", Courier, monospace;
        color: var(--ink-dark);
        font-size: 12px;
        font-weight: bold;
    }

    .sqs-entity-wrapper .legal-disclaimer {
        grid-column: span 2;
        font-family: "Courier New", Courier, monospace;
        font-size: 10px;
        color: var(--ink-dark);
        background: #e8dfc8;
        padding: 8px;
        border-left: 3px solid var(--ink-dark);
        margin-top: 8px;
    }

    /* Archival Action Links */
    .sqs-entity-wrapper .card-actions {
        margin-top: 14px;
        text-align: right;
    }

    .sqs-entity-wrapper .action-btn {
        display: inline-block;
        font-family: "Courier New", Courier, monospace;
        font-size: 11px;
        font-weight: bold;
        color: var(--ink-dark) !important;
        text-decoration: none !important;
        border-bottom: 1px solid var(--ink-dark);
        transition: opacity 0.2s;
    }

    .sqs-entity-wrapper .action-btn:hover { opacity: 0.6; }
    .sqs-entity-wrapper .action-btn::after { content: " ↗"; }
</style>

